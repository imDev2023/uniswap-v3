# Foundry configuration. Copy to `contracts/.env` and fill in. `forge` loads this file
# automatically for every `forge test` / `forge script` run in this directory.
#
# NOTHING IN `.env` IS SAFE TO COMMIT. `.gitignore` excludes it; only this template is tracked.

# --- Archive RPC endpoints: REQUIRED for `forge test` ------------------------------------------
#
# Every fork test pins its block (see test/ForkConfig.sol), and a pinned block can only be served
# by a node that still holds state at that height. The chains' documented public endpoints prune
# after roughly 5,000 blocks - measured 2026-08-01, an `eth_call` at testnet block 95,062,912
# returns `-32000 missing trie node` from the public endpoint and answers normally from an archive
# node - so `forge test` needs archive access or the fork suites fail with
# `environment variable RPC_MAINNET_ARCHIVE_URL not found`. That failure is deliberate: a fork test
# quietly falling back to a pruning endpoint is what made these suites flaky in the first place.
#
# Alchemy serves both Robinhood chains from ONE key; only the subdomain differs. Robinhood's own
# docs recommend Alchemy, and QuickNode, Blockdaemon, dRPC and Validation Cloud also serve 4663.
RPC_TESTNET_ARCHIVE_URL=https://robinhood-testnet.g.alchemy.com/v2/<your-alchemy-key>
RPC_MAINNET_ARCHIVE_URL=https://robinhood-mainnet.g.alchemy.com/v2/<your-alchemy-key>

# --- Deploy keys: only needed to BROADCAST (docs/deploy.md) -------------------------------------
#
# Unset for `forge test` and for fork dry-runs. The deploy scripts read these.
PRIVATE_KEY=
# The owner/treasury address. On testnet this is the deployer EOA; before mainnet it MUST become a
# real multisig (see CLAUDE.md -> Open decisions).
SAFE=

# --- Multi-wallet testnet exercises: optional --------------------------------------------------
#
# Six funded testnet EOAs used to exercise the anti-snipe cap across competing buyers.
TEST_PK_1=
TEST_PK_2=
TEST_PK_3=
TEST_PK_4=
TEST_PK_5=
TEST_PK_6=

# --- Blockscout verification: optional ----------------------------------------------------------
#
# Robinhood Chain's explorer is Blockscout, which is keyless - the api-key is a placeholder it
# ignores. See foundry.toml [etherscan] and docs/deploy.md.
BLOCKSCOUT_API_KEY=placeholder
BLOCKSCOUT_MAINNET_API=
BLOCKSCOUT_TESTNET_API=
